{
  "version": 1,
  "author": "MIDI Captain MAX",
  "editor": "wokwi",
  "comment": "NANO4 (4-switch). Switch 2 (TR) is on board.LED/GP25, an internal Pico pin absent from Wokwi, so it is omitted — only the wirable switches appear. See firmware/dev/devices/nano4.py.",
  "parts": [
    {
      "type": "wokwi-pi-pico",
      "id": "pico",
      "top": 0,
      "left": 0,
      "attrs": { "env": "circuitpython-7.3.3" }
    },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": -80, "left": -40, "attrs": { "label": "TL" } },
    { "type": "wokwi-pushbutton", "id": "btn3", "top": 200, "left": -40, "attrs": { "label": "BL" } },
    { "type": "wokwi-pushbutton", "id": "btn4", "top": 200, "left": 60, "attrs": { "label": "BR" } },
    {
      "type": "wokwi-neopixel",
      "id": "led0",
      "top": 80,
      "left": 300,
      "attrs": {}
    }
  ],
  "connections": [
    ["pico:GP1", "btn1:1.l", "green", []],
    ["pico:GND.1", "btn1:2.l", "black", []],
    ["pico:GP9", "btn3:1.l", "blue", []],
    ["pico:GND.1", "btn3:2.l", "black", []],
    ["pico:GP10", "btn4:1.l", "blue", []],
    ["pico:GND.1", "btn4:2.l", "black", []],
    ["pico:GP7", "led0:DIN", "orange", []],
    ["pico:GND.1", "led0:VSS", "black", []],
    ["pico:VBUS", "led0:VDD", "red", []]
  ],
  "serialMonitor": { "display": "auto" }
}
